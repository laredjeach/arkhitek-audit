# Required for Leg 2 (audit) and Leg 3 (email drafting)
ANTHROPIC_API_KEY=

# Optional: Firecrawl for Leg 1 deep discovery + Leg 2 scraping
# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=

# Optional: SerpAPI for Google-backed discovery in Leg 1
# Get a key at https://serpapi.com
SERPAPI_KEY=

# Optional: Google Custom Search Engine for Leg 1
# Create at https://programmablesearchengine.google.com
GOOGLE_CSE_ID=
GOOGLE_API_KEY=

# Optional: Claude model override (defaults to claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Sender info for email templates
SENDER_NAME=Jared
SENDER_COMPANY=Arkhitek
