# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Runtime data (generated by the audit engine) ──────────────────────────────
# Ignore all data files but preserve directory structure via .gitkeep
leads/*
!leads/.gitkeep

runs/audits/*
!runs/audits/.gitkeep
runs/scrapes/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Editor ────────────────────────────────────────────────────────────────────
.cursor/
.vscode/
*.swp
*.swo
